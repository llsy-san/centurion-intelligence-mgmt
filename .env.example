# 百夫长智能管理系统 - 环境配置文件

# ===========================================
# 数据库配置
# ===========================================
DATABASE_URL=postgresql://postgres:centurion123@localhost:5432/centurion_db
POSTGRES_DB=centurion_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=centurion123

# ===========================================
# Redis 缓存配置
# ===========================================
REDIS_URL=redis://:centurion123@localhost:6379
REDIS_PASSWORD=centurion123

# ===========================================
# 文件存储配置
# ===========================================
# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=uploads

# 文件服务配置
FILE_DEFAULT_STORAGE=local
FILE_MAX_SIZE=52428800
FILE_UPLOAD_PATH=./uploads

# 阿里云 OSS 配置（可选）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_REGION=cn-hangzhou

# ===========================================
# 任务调度配置
# ===========================================
# Celery 配置
CELERY_BROKER_URL=redis://:centurion123@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:centurion123@localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true

# Flower 监控配置
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:admin123

# 定时任务配置
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_BEAT_SCHEDULE_FILENAME=celerybeat-schedule

# ===========================================
# AI 服务配置
# ===========================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# ===========================================
# 应用配置
# ===========================================
# 调试模式
DEBUG=true
LOG_LEVEL=INFO

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API 配置
API_V1_STR=/api/v1
PROJECT_NAME=百夫长智能管理系统

# ===========================================
# 服务端口配置
# ===========================================
API_GATEWAY_PORT=8001
ORDER_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
SHIPPING_SERVICE_PORT=8004
AI_AGENT_SERVICE_PORT=8005
TASK_SCHEDULER_SERVICE_PORT=8006

# 基础设施端口
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===========================================
# 外部服务配置
# ===========================================
# 支付服务配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
WECHAT_PAY_MCH_ID=your-wechat-mch-id
WECHAT_PAY_API_KEY=your-wechat-api-key

# 物流服务配置
SF_EXPRESS_API_KEY=your-sf-express-api-key
YTO_EXPRESS_API_KEY=your-yto-express-api-key

# ===========================================
# 安全配置
# ===========================================
# CORS 配置
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# 限流配置
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ===========================================
# 监控配置（可选）
# ===========================================
# 日志配置
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 性能监控
ENABLE_METRICS=false
METRICS_PORT=9090